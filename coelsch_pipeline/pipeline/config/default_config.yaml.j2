### PIPELINE INPUT/OUTPUT

{%- set crossing_combinations = crossing_combinations | default(['(col0*ler)']) %}
{%- set founder_haplotypes = founder_haplotypes | default(parse_founder_haplotypes(crossing_combinations)) %}
{%- set reference_name = reference_name | default(founder_haplotypes[0]) %}
{%- set dataset_name = dataset_name | default('example_dataset') %}
{%- set input_fastq_basename = input_fastq_basename | default(dataset_name) %}
{%- set technology = technology | default('10x_rna') %}
{%- if reference_name not in founder_haplotypes %}
{{ raise_error('reference_name "' ~ reference_name ~ '" is not one of the founder haplotypes in crossing_combinations: ' ~ founder_haplotypes | join(', ')) }}
{%- endif %}

# Annotation files defined below are located relative to annotation_dir.
annotation_dir: "{{ annotation_dir | default('annotations') }}"

annotations:
  fasta_fns:
    # FASTA files are required for all founder haplotypes in crossing_combinations.
    # Defaults are "<haplotype>.fa".
{{ format_founder_fasta_fns(founder_haplotypes) }}

  gtf_fns:
    # A GTF is required for each reference genotype used for mapping.
    {{ reference_name }}: "{{ reference_name }}.gtf"

  barcode_whitelist_fns:
    # Barcode whitelist for the selected technology.
    {{ technology }}: {{ barcode_whitelist_fns | default("['3M-3pgex-may-2023.txt']" if technology == '10x_rna' else 'null') }}

  vcf_fns:
    # Optional VCFs for precomputed variants. If null, variants are generated
    # from founder FASTAs where required.
    {{ reference_name }}: null

  mask_bed_fns:
    # Optional BED file of regions to mask during marker cleaning for coelsch.
    {{ reference_name }}: null


# Input FASTQ files are searched for within this directory.
raw_data_dir: "{{ raw_data_dir | default('raw_data') }}"

# Results are created within this directory.
results_dir: "{{ results_dir | default('results') }}"

# Sample IDs and sample-specific information.
datasets:
  {{ dataset_name }}:
    # Sequencing technology preset passed to coelsch --seq-type.
    # Choices: 10x_rna, 10x_atac, bd_rna, takara_dna, wgs, other
    technology: "{{ technology }}"

    # Unit represented by each barcode/sample.
    # Choices: auto, single_cell, bulk
    sample_unit: "{{ sample_unit | default('auto') }}"

    # Biological stage of the sampled material.
    # Choices: gametes, progeny
    lifecycle_stage: "{{ lifecycle_stage | default('gametes') }}"

    # Experimental crossing design.
    # Choices: f1, f2, backcross, testcross, three_way, four_way
    # This is explicit because a genotype expression may be ambiguous without
    # lifecycle context, e.g. "(A*B)" can be F1 gametes or F2 progeny.
    crossing_strategy: "{{ crossing_strategy | default('f1') }}"

    # Genotyping mode.
    # Choices: auto, founder, recombinant
    # auto uses recombinant mode when recombinant_parent_jsons is supplied.
    genotyping_strategy: "{{ genotyping_strategy | default('auto') }}"

    # Genotype expressions passed directly to coelsch --crossing-combinations.
    # Multiple entries are allowed for pooled-cross datasets.
    # Examples:
    #   f1:         "(col0*ler)"
    #   f2:         "(col0*ler)"
    #   backcross:  "(col0*(col0*ler))"
    #   testcross:  "(col0*(ler*cvi0))"
    #   three_way:  "((col0*ler)*(col0*cvi0))"
    #   four_way:   "((c24*tsu0)*(cvi0*no0))"
    crossing_combinations:
{{ format_crossing_combinations(crossing_combinations) }}

    # Reference genotype used for mapping. Must be one of the founder haplotypes
    # in crossing_combinations.
    reference_genotype: "{{ reference_name }}"

    # Optional PredictionRecords JSONs used for recombinant genotyping. This may
    # contain one diploid parental prediction file or two haploid parent files.
    recombinant_parent_jsons: []

    input_file_basenames:
      # Base names of files considered part of this dataset. Files are located
      # under raw_data_dir and combined with file_suffixes below.
      - "{{ input_fastq_basename }}"
      # Glob wildcards can also be used, e.g.:
      # - "{{ dataset_name }}_*"


file_suffixes:
  read1: ".1.fastq.gz" # file containing the fwd read (barcode seqs in 10x/BD RNA, DNA in 10x ATAC or wgs methods)
  read2: ".2.fastq.gz" # file containing the rev read (cDNA seqs in 10x/BD RNA, DNA in 10x ATAC or wgs method)
  barcode: ".bc.fastq.gz" # not present in 10x/BD RNA or wgs methods, contains cell barcode in  10x ATAC
  barcode_rc: ".bc_rc.fastq.gz" # file containing the reverse complemented 10x ATAC barcode sequences
                                # (this is autogenerated if required, see preprocessing)

runtime:
  # Optional scratch directory for temporary files. If null, rules use $TMPDIR
  # where available, otherwise /tmp.
  tmpdir: null

  # the pipeline ships with env_yamls that will be installed by snakemake 
  # if you prefer to supply your own yamls or use other pre-installed environments for certain steps,
  # you can use this section to override them.
  conda_envs:
    genmap: null # environment used for rules involving genmap, requires genmap, bedtools, samtools
    anianns: null # environment used for rules involving anianns, requires anianns, seqkit
    minimap2: null # environment used for rules involving minimap2, requires minimap2, samtools
    htslib: null # environment used for rules involving samtools/bcftools/bgzip/tabix
    seqtk: null # environment used for rules involving seqtk
    syri: null # environment used for rules involving syri (see https://github.com/schneebergerlab)
    star: null # environment used for rules involving STAR, requires STAR=2.7.11a
    coelsch: null # environment used for rules involving coelsch, also requires seaborn, ipykernel, nbconvert for notebooks


  # Rule resources. Each entry supports:
  #   threads: number of threads requested by the rule
  #   mem_mb: fixed total memory in MB
  #   mem_per_thread: memory in MB per thread
  # If mem_per_thread is set, it overrides mem_mb.
  resources:
    default:
      threads: 4
      mem_mb: 8000

    genmap:
      threads: 16
      mem_per_thread: 1024

    anianns:
      threads: 16
      mem_per_thread: 1024

    minimap2:
      threads: 12
      mem_per_thread: 1024

    syri:
      threads: 1
      mem_mb: 5000

    bedtools:
      threads: 1
      mem_mb: 5000

    bcftools:
      threads: 1
      mem_mb: 5000

    seqtk:
      threads: 1
      mem_mb: 4000

    star:
      index:
        threads: 12
        mem_per_thread: 1024

      align:
        plate:
          threads: 6
          mem_per_thread: 2048

        droplet:
          threads: 24
          mem_per_thread: 2048

    samtools:
      sort:
        threads: 12
        mem_mb: 20000

      view: # for rules filtering reads
        threads: 4
        mem_mb: 20000

      merge:
        sample: # for a single sample/barcode in a plate wgs dataset
          threads: 4
          mem_per_thread: 1024

        dataset: # for a full single cell or merged plate-based dataset
          threads: 24
          mem_per_thread: 1024

      dedup:
        threads: 12
        mem_mb: 10000

    coelsch:
      loadbam:
        threads: 48
        mem_mb: 150000

      clean:
        threads: 1
        mem_mb: 50000

      predict:
        threads: 48
        mem_mb: 150000

    haplotyping_report:
      threads: 1
      mem_mb: 50000


### PIPELINE PARAMS:

preprocessing:
  atac:
    rev_comp_barcode: True # necessary for some sequencing methods e.g. nanoball seq

variants:
  mappability:
    kmer_size: 100 # the kmer size for genmap mappability calculation
    edit_dist: 2 # number of edits allowed between kmers to consider them the same
    min_mappability: 0.51 # the min mappability to keep variants in - others are removed
    mask_repeats: False # whether to use AniAnns to additionally mask satellite repeat regions e.g. CEN and 5S
    mask_gap_size: 500 # min number of basepairs between two masked regions before they are merged together

  minimap2:
    preset: "asm10" # the preset used for whole genome alignment. see minimap manual
    zdrop: "500" # can be a single int or pair of ints, see minimap manual

  syri:
    use_low_qual_filters: False # whether to use syris default filtering
    include_inversions: True # whether to retain variants in regions labelled as inversions

  star_consensus:
    max_hdr_length: 0 # the maximum size of syri HDRs to try to resolve to snps/indels
    max_indel_size: 50 # indels above this length are not used. Setting this higher than read length may cause instability

alignment:
  star:
    sjdb_overhang_length: null # add an int. If null, will be identified from the data
    genome_sa_index_nbases: null # add an int. If null, will be identified from the data
    filter_multimap_nmax: 1 # removes alignments that multimap more than this many times
    filter_mismatch_nmax: 4 # removes alignments with more than this many mismatches

    rna:
      umi_dedup_method: "1MM_Directional_UMItools" # Method used for deduplication of unique molecular identifiers
      align_intron_min: 60
      align_intron_max: 20000
      align_sj_overhang_min: 12 # how much sequence is required to align after an unannotated splice junction
      align_sjdb_overhang_min: 4 # how much sequence is required to align after a splice junction annotated in GTF

    atac:
      mates_gap_max: 500 # the maximum insert size (distance between aligned paired ended reads)

haplotyping:
  load:
    min_alignment_score: 0.95 # only reads with length-normalised alignment score above this value are used
    min_mapq: null # optional minimum MAPQ for reads used as haplotype markers
    exclude_contigs: null # comma-separated contig names to exclude; null uses coelsch defaults
    validate_barcodes: auto # choices: auto, true, false. auto should be resolved from technology/sample_unit

  clean:
    min_markers_per_barcode: 100 # minimum informative markers required per barcode/sample
    min_markers_per_chrom: 20 # minimum informative markers required per chromosome per barcode/sample
    min_genotyping_probability: 0.9 # minimum probability for assigned genotype in pooled-genotype datasets
    max_genotyping_error_rate: 0.25 # maximum background/error rate inferred during genotyping
    normalise_bins: true # normalise bin coverage to reduce marker density/expression biases
    bin_shrinkage_quantile: 0.99 # quantile used when computing bin-normalisation shrinkage
    normalise_depth: auto # choices: auto, true, false. auto should be resolved from sample_unit/technology
    max_bin_count: null # optional maximum markers per barcode/sample per bin; higher values are thresholded
    mask_imbalanced: true # whether to mask bins with extreme haplotype imbalance
    max_marker_imbalance: 0.75 # maximum allowed global haplotype/bin imbalance before masking
    clean_by_genotype: false # whether to apply cleaning separately to each assigned genotype

    single_cell:
      clean_background: true # whether to estimate and remove background markers
      max_fraction_background: 0.5 # maximum allowed estimated background marker rate before filtering

    bulk:
      filter_pcr_duplicates: false # used only for data without UMIs

  predict:
    genomic_bin_size: 25000 # bin size for marker distribution
    segment_size: 1000000 # approximate minimum distance between crossovers in the rigid HMM
    terminal_segment_size: 250000 # approximate minimum distance of crossovers from chromosome ends
    cm_per_mb: 4.5 # expected crossover frequency in centiMorgans per megabase
    interference_half_life: 5000 # distance below segment_size where recombination rate halves exponentially
    distribution_type: poisson # choices: poisson, nb
    sample_co_locs: true # sample stochastic crossover locations for each barcode/sample
    n_samples: 25 # number of stochastic crossover-location samples per barcode/sample
    predict_doublets: auto # choices: auto, true, false. auto disables for bulk datasets
    n_doublets: 1000 # number of synthetic doublets to simulate when doublet prediction is enabled
    nco_min_prob_change: 0.0025 # minimum probability change used when estimating crossover counts
    batch_size: 128 # batch size for prediction
